    <!-- Settings: Decode -->
    <string name="setting_h265">H.265 (HEVC)</string>
    <string name="setting_h265_desc">Activa la decodificación de video H.265 si el dispositivo la admite</string>
    <string name="setting_enforce_sdr">MediaFormat.KEY_COLOR_TRANSFER</string>
    <string name="setting_enforce_sdr_desc">Marca el video como SDR limitado; desactívalo para permitir el paso de fuentes HDR</string>
    <string name="setting_alac">Audio ALAC</string>
    <string name="setting_alac_desc">Códec ALAC para la transmisión de música por AirPlay</string>
    <string name="setting_lossless_output">Salida PCM sin pérdida</string>
    <string name="setting_lossless_output_desc">Mantiene el ALAC decodificado con ganancia unitaria, sin escalar el volumen dentro de la app. Usa el volumen de la TV o del receptor.</string>
    <string name="setting_spatial_enhancement">Mejora espacial / envolvente</string>
    <string name="setting_spatial_enhancement_desc">Amplía el sonido estéreo con un procesamiento ligero dentro de la app. No es Dolby Atmos.</string>
    <string name="setting_karaoke_mode">Karaoke inteligente / Enfoque vocal</string>
    <string name="setting_karaoke_mode_desc">Detecta y reduce la voz principal centrada en el estéreo, protegiendo los graves, el ambiente estéreo, el detalle agudo y los ataques marcados de los instrumentos. Presiona OK en la pantalla de letras para ajustar el nivel de la voz.</string>
    <string name="setting_ai_vocal_separation">Separación vocal con IA (Experimental)</string>
    <string name="setting_ai_vocal_separation_desc">Usa un modelo UVR MDX-Net en el dispositivo para aislar la pista vocal real. Agrega unos 6–10 segundos de latencia y regresa automáticamente al Enfoque vocal inteligente si esta TV no puede con la carga.</string>
    <string name="setting_ai_vocal_separation_unsupported_desc">Esta TV de 32 bits no puede ejecutar UVR MDX-Net en tiempo real. El Enfoque vocal inteligente sigue disponible sin IA.</string>
    <string name="setting_sw_alac">Decodificador ALAC por software</string>
    <string name="setting_sw_alac_desc">Usa el decodificador integrado si el ALAC de la plataforma no está disponible</string>
    <string name="setting_aac">Audio AAC</string>
    <string name="setting_aac_desc">Códec AAC-ELD o AAC-LC para el audio de la duplicación de pantalla</string>

