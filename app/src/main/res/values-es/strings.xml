    <string name="setting_keep_screen_on_desc">Evita que se apague la pantalla mientras hay un cliente conectado</string>
    <string name="setting_advertise_video">Anunciar compatibilidad con video AirPlay</string>
    <string name="setting_advertise_video_desc">Si está desactivado, se usa la bocina dedicada compatible con Música de macOS</string>
    <string name="setting_advertise_audio">Anunciar compatibilidad con audio AirPlay</string>
    <string name="setting_advertise_audio_desc">Si está desactivado, el dispositivo solo se podrá usar para duplicar pantalla y se ocultará en los reproductores multimedia</string>
    <string name="setting_launch_on_connect">Abrir esta aplicación al conectar</string>
    <string name="setting_launch_on_connect_desc">Muestra la pantalla cuando se conecta un cliente</string>
