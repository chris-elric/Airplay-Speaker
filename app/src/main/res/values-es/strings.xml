    <string name="setting_motion_artwork">Portada de álbum animada</string>
    <string name="setting_motion_artwork_desc">Activa las portadas en movimiento y los efectos de álbum cuando estén disponibles</string>
    <string name="setting_fullscreen_motion_artwork">Portada animada a pantalla completa</string>
    <string name="setting_fullscreen_motion_artwork_desc">Llena el fondo del reproductor con la portada animada; desactívalo para conservar la portada animada clásica</string>
    <string name="setting_auto_fullscreen">Entrar a pantalla completa automáticamente</string>
    <string name="setting_auto_fullscreen_desc">Entra a pantalla completa cuando se conecta un cliente</string>
