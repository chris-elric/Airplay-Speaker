    <string name="setting_key_allow_frame_drop">MediaFormat.KEY_ALLOW_FRAME_DROP</string>
    <string name="setting_key_allow_frame_drop_desc">Permite que los decodificadores de video descarten fotogramas internamente para mantener el ritmo en Android 10+</string>
    <string name="setting_realtime_decoder_priority">MediaFormat.KEY_PRIORITY</string>
    <string name="setting_realtime_decoder_priority_desc">Solicita programación en tiempo real para los decodificadores de audio y video</string>
    <string name="setting_operating_rate_hint">MediaFormat.KEY_OPERATING_RATE</string>
    <string name="setting_operating_rate_hint_desc">Solicita la tasa de operación máxima para el decodificador de video</string>
    <string name="setting_scheduled_output_buffer_release">Sincronización alineada de fotogramas</string>
    <string name="setting_scheduled_output_buffer_release_desc">Programa cada fotograma decodificado para el VSYNC que coincide con su marca de tiempo de presentación</string>
