    <!-- Lyrics -->
    <string name="section_lyrics">Letras</string>
    <string name="setting_apple_token">Token de tu cuenta de Apple Music</string>
    <string name="setting_apple_token_desc">Opcional pero recomendado. Pega la cookie media-user-token de music.apple.com (herramientas de desarrollo del navegador → Aplicación → Cookies) para obtener las letras palabra por palabra de Apple con tu cuenta. Se queda en este dispositivo y solo se envía a Apple. Presiona Listo para guardar; deja el campo vacío para quitarlo.</string>
    <string name="setting_apple_token_label">media-user-token</string>
    <string name="setting_lyrics_translation">Traducir letras</string>
    <string name="setting_lyrics_translation_desc">Muestra una traducción debajo de cada línea, como en la app de Apple Music.</string>
    <string name="setting_lyrics_translation_language">Idioma de traducción</string>
    <string name="setting_lyrics_translation_language_desc">Se usa primero la traducción de Apple si existe; después Musixmatch y, por último, Google.</string>
    <string name="setting_lyrics_translation_language_placeholder">Código de idioma (p. ej., es)</string>
    <string name="setting_musixmatch_token">Token de Musixmatch</string>
    <string name="setting_musixmatch_token_desc">Token de usuario de Musixmatch, opcional, para las traducciones. Déjalo vacío para usar uno anónimo.</string>
    <string name="setting_musixmatch_token_label">Token de usuario de Musixmatch</string>
    <string name="lyrics_token_set">Guardado</string>
    <string name="lyrics_token_not_set">Sin configurar</string>
    <string name="btn_save_token">Guardar</string>
    <string name="btn_cancel_token">Cancelar</string>
    <string name="setting_lyrics_extra">Línea extra bajo la letra</string>
    <string name="setting_lyrics_extra_desc">Muestra una traducción, una romanización (pinyin, romaji…) o ambas bajo cada línea. Se usa primero la de Apple cuando está disponible.</string>
    <string name="lyrics_extra_off">Desactivada</string>
    <string name="lyrics_extra_translation">Traducción</string>
    <string name="lyrics_extra_romanization">Romanización</string>
    <string name="lyrics_extra_both">Ambas</string>
    <string name="setting_lyrics_delay">Retraso de la letra</string>
    <string name="setting_lyrics_delay_desc">Los valores positivos muestran cada línea antes (úsalo cuando el audio va adelantado respecto a la letra); los negativos la muestran después. OK recorre valores predefinidos; izquierda/derecha ajusta de 0.05 s en 0.05 s.</string>
    <string name="setting_lyrics_delay_placeholder">Milisegundos (p. ej., 500)</string>
